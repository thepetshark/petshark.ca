---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Lists the home page and the project pages, and nothing else on purpose: standalone pages
  (privacy policies, support pages) and dev logs are not listed. A page can also opt out with `noindex: true`.
{%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign listed = site.pages | where_exp: "p", "p.layout == 'home' or p.layout == 'default'" | concat: site.projects %}
{%- for p in listed %}
  {%- unless p.noindex or p.url == '/404.html' %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
  {%- endunless %}
{%- endfor %}
</urlset>
