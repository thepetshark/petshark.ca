<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Lists the home page and the project pages, and nothing else on purpose: standalone pages
  (privacy policies, support pages) and dev logs are not listed. A project can opt out with noindex: true.
{%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ "/" | absolute_url }}</loc></url>
{%- for p in site.projects %}
  {%- unless p.noindex %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
  {%- endunless %}
{%- endfor %}
</urlset>
